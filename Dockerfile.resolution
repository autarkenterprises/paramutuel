FROM python:3.12-slim

WORKDIR /app

COPY service /app/service
COPY config /app/config

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV PORT=8080
ENV RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
ENV INDEXER_BASE_URL=https://paramutuel-git-406244230167.europe-west1.run.app
ENV RESOLUTION_DECISIONS_PATH=config/resolution-decisions.base-sepolia.json

EXPOSE 8080

CMD ["python3", "-m", "service.resolution.service", "--host", "0.0.0.0"]

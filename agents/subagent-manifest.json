{
  "title": "Paramutuel subagent registry (machine hint)",
  "description": "Stable, parseable pointers for autonomous agents and integrators. Not a network protocol.",
  "version": 1,
  "project": {
    "name": "paramutuel",
    "repository": "https://github.com/autarkenterprises/paramutuel",
    "human_docs": "https://github.com/autarkenterprises/paramutuel/blob/master/docs/BET-AGENT.md",
    "agent_entrypoint_doc": "https://github.com/autarkenterprises/paramutuel/blob/master/AGENTS.md",
    "distribution_guide": "https://github.com/autarkenterprises/paramutuel/blob/master/docs/BET-AGENT-DISTRIBUTION.md"
  },
  "subagents": [
    {
      "id": "io.github.autarkenterprises.paramutuel.bettor",
      "display_name": "Paramutuel bet scout",
      "summary": "Indexer-backed discovery and parimutuel odds; JSON in/out for subagent delegation. No private keys.",
      "python_module": "agents.paramutuel_bettor",
      "invocation": {
        "type": "stdio_json",
        "command_hint": [
          "python3",
          "-m",
          "agents.paramutuel_bettor",
          "json"
        ],
        "stdin": "Single JSON object per process; see docs/BET-AGENT.md",
        "stdout": "Single JSON object",
        "working_directory": "repository_root",
        "environment": [
          "INDEXER_URL",
          "PYTHONPATH=."
        ]
      },
      "operations": [
        {
          "op": "health"
        },
        {
          "op": "scan",
          "fields": ["state", "limit", "order", "q"]
        },
        {
          "op": "recommend",
          "fields": [
            "bet_amount_raw",
            "strategy",
            "scan_limit",
            "min_total_pot_raw",
            "proposition_contains",
            "top"
          ]
        },
        {
          "op": "quote",
          "fields": ["wager_address", "outcome_index", "bet_amount_raw", "freeform_answer"]
        }
      ],
      "distribution": {
        "pypi_package": "paramutuel-bettor-agent",
        "pypi_project_url": "https://pypi.org/project/paramutuel-bettor-agent/",
        "console_script": "paramutuel-bettor",
        "pip_install": ["pip", "install", "paramutuel-bettor-agent"],
        "oci_image_template": "ghcr.io/<github-owner-lowercase>/paramutuel-bettor-agent:<semver>",
        "release_git_tag_template": "bettor-agent-v<semver>"
      },
      "complements": [
        {
          "type": "mcp_server",
          "package": "paramutuel-mcp",
          "pypi": "https://pypi.org/project/paramutuel-mcp/",
          "note": "Use MCP quote_place_bet / encode_place_bet_freeform / encode_create_enumerated_wager before signing (indexer protocol_version: enumerated, freeform); see docs/AGENT-LOOP.md"
        }
      ],
      "cursor_skill_path": ".cursor/skills/paramutuel-bettor/SKILL.md"
    }
  ]
}

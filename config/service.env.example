# Central environment configuration for local orchestration.
#
# Copy to `config/service.env` and edit values:
#   cp config/service.env.example config/service.env
#
# Local deploy scripts source `script/lib/load_service_env.sh`, which exports
# everything defined here into the current shell environment.
#
# NOTE: This file is intentionally example-only. Do not commit secrets.

# --- Chain / deployment basics (required for most on-chain actions) ---
RPC_URL_BASE_SEPOLIA="https://sepolia.base.org"
PRIVATE_KEY="0xREPLACE_WITH_DEPLOYER_OR_OPERATOR_PRIVATE_KEY"
TREASURY_ADDRESS="0xREPLACE_WITH_TREASURY_SAFE_OR_MULTISIG"

# Protocol fee & timing defaults (used by launch_testnet.sh)
PROTOCOL_FEE_BPS=100
MIN_BETTING_WINDOW=3600
MIN_RESOLUTION_WINDOW=3600

# --- Operator auth (required only for execute paths) ---
CONTROL_PANEL_TOKEN="replace-with-long-random-token"

# --- Indexer / explorer (local or hosted URL) ---
INDEXER_BASE_URL="http://127.0.0.1:8090"
# Optional: uncomment to force MCP / bet agent indexer base (else use deployments.json).
# INDEXER_URL="https://your-indexer.example"

# --- Resolution Service (delegated resolver ops) ---
# Optional: if omitted, the service derives resolver address from PRIVATE_KEY.
RESOLUTION_SERVICE_ADDRESS=""
# Optional: override decisions file path.
RESOLUTION_DECISIONS_PATH="config/resolution-decisions.base-sepolia.json"

# --- Proposition Service (drafts + operator review + optional dispatch) ---
PROPOSITION_PANEL_TOKEN="replace-with-long-random-proposition-token"

# Required when dispatch is enabled (PROPOSITION_ALLOW_EXECUTE=1).
PROPOSITION_COLLATERAL_TOKEN="0xREPLACE_WITH_COLLATERAL_ERC20_ADDRESS"

# Optional: override from env; otherwise read from config/deployments.json.
PROPOSITION_FACTORY=""

# Dispatch gate:
#   1 / true => allow dispatch endpoint to execute cast send
PROPOSITION_ALLOW_EXECUTE=0

# Betting close time offset at dispatch.
PROPOSITION_BETTING_CLOSE_OFFSET_SEC=604800   # 7 days

# Resolution window passed to createWager.
PROPOSITION_RESOLUTION_WINDOW_SEC=259200       # 3 days

# Optional: set role addresses; if omitted server passes 0x0 (subject to factory constraints).
PROPOSITION_RESOLVER=""
PROPOSITION_BETTING_CLOSER=""
PROPOSITION_RESOLUTION_CLOSER=""

# Optional extra fee slots
PROPOSITION_EXTRA_FEE_RECIPIENTS=""
PROPOSITION_EXTRA_FEE_BPS=""

